# Dashboard password for authentication
DASHBOARD_PASSWORD=your_secure_password_here

# ERPNext base URL (no /api at the end) - numbers set to source "erp" in config/dashboard.config.ts come from here
FACTORY_API_URL=https://your-erpnext-site.com

# ERPNext API key and secret of the dashboard user (sent as "Authorization: token KEY:SECRET")
FACTORY_API_KEY=your_api_key_here
FACTORY_API_SECRET=your_api_secret_here

# IT agent (صفحة IT والمراقبة): سر طويل عشوائي، نفس القيمة في الإيجنت على جهاز IT - long random secret, same value in the agent
IT_AGENT_SECRET=change_me_to_a_long_random_secret

# Upstash Redis / Vercel KV (عشان آخر حالة من الإيجنت تعيش بعد الـ cold start) - keeps the latest IT status across cold starts
# Vercel → Storage → Upstash بيضيفهم لوحده - added automatically by the Vercel Upstash integration
KV_REST_API_URL=
KV_REST_API_TOKEN=

# شاشة الأوبريتر (/operator): رقم سري 4 أرقام بيتشيك على السيرفر - the operator screen's 4-digit PIN (checked on the server)
OPERATOR_PIN=

# Dashboard password for authentication
DASHBOARD_PASSWORD=your_secure_password_here

# ERPNext base URL (no /api at the end) - numbers set to source "erp" in config/dashboard.config.ts come from here
FACTORY_API_URL=https://your-erpnext-site.com

# ERPNext API key and secret of the dashboard user (sent as "Authorization: token KEY:SECRET")
FACTORY_API_KEY=your_api_key_here
FACTORY_API_SECRET=your_api_secret_here
